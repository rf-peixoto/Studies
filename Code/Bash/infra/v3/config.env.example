# container-generator config — copy to config.env next to the script.
# Every line is optional; anything you omit keeps the built-in default.
# Command-line flags (--mem, --cpus, --total, ...) override values set here.

# --- Users / layout ---
# TOTAL_USERS=5
# BASE_DIR="/opt/kali_container_vps"     # default: ./kali_container_vps
# IMAGE_NAME="multiuser-kali-ssh:latest"
# CONTAINER_PREFIX="user"
# SSH_USER="user"

# --- Per-container resource limits ("" = no limit for that dimension) ---
# MEM_LIMIT="8g"
# CPU_LIMIT="2"          # cores; e.g. "1.5"
# PIDS_LIMIT="512"       # max processes (anti fork-bomb)
# DISK_LIMIT="10g"       # needs xfs+pquota / btrfs / zfs; ignored if unsupported
# REQUIRE_DISK_QUOTA=0   # 1 = refuse to run if disk cap can't be enforced

# --- Ports (deterministic per user number) ---
# SSH_PORT_START=65535       # user 1 -> 65535, user 2 -> 65534, ...
# SERVICE_PORT_START=20001   # user 1 -> 20001, user 2 -> 20002, ...

# --- Networking ---
# NETWORK_NAME="kalinet"
# NETWORK_MODE="isolated"       # isolated = one bridge per user (no peer access)
#                               # shared   = all users on one bridge
# ALLOW_TCP_FORWARDING="no"     # "yes" to permit SSH tunneling / pivoting

# --- Lifetime ---
# DEFAULT_TTL_DAYS=0            # 0 = never expire; >0 needs --reap or --install-reaper

# --- Access files ---
# PUBLIC_IP=""                 # leave blank to auto-detect; set for NAT/VPN hosts
